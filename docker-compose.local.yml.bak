# Standalone compose file for running PostHog locally with remapped ports
# to avoid conflicts with other running containers.
# UI accessible at http://localhost:6800

services:
  db:
    image: postgres:15.12-alpine
    restart: on-failure
    environment:
      POSTGRES_USER: posthog
      POSTGRES_DB: posthog
      POSTGRES_PASSWORD: posthog
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U posthog']
      interval: 5s
      timeout: 30s
      retries: 30
      start_period: 10s
    volumes:
      - ./docker/postgres-init-scripts:/docker-entrypoint-initdb.d
      - posthog-local-pg-data:/var/lib/postgresql/data
    ports:
      - '6432:5432'

  redis7:
    image: redis:7.2-alpine
    restart: on-failure
    command: redis-server --maxmemory-policy allkeys-lru --maxmemory 200mb
    healthcheck:
      test: ['CMD', 'redis-cli', 'ping']
      interval: 3s
      timeout: 10s
      retries: 10
    ports:
      - '6479:6379'

  zookeeper:
    image: zookeeper:3.7.0
    restart: on-failure

  kafka:
    image: docker.redpanda.com/redpandadata/redpanda:v25.1.9
    restart: on-failure
    command:
      - redpanda
      - start
      - --kafka-addr internal://0.0.0.0:9092,external://0.0.0.0:19092
      - --advertise-kafka-addr internal://kafka:9092,external://localhost:19092
      - --pandaproxy-addr internal://0.0.0.0:8082,external://0.0.0.0:18082
      - --advertise-pandaproxy-addr internal://kafka:8082,external://localhost:18082
      - --schema-registry-addr internal://0.0.0.0:8081,external://0.0.0.0:18081
      - --rpc-addr kafka:33145
      - --advertise-rpc-addr kafka:33145
      - --mode dev-container
      - --smp 1
      - --memory 1G
      - --reserve-memory 200M
      - --overprovisioned
      - --set redpanda.empty_seed_starts_cluster=false
      - --seeds kafka:33145
      - --set redpanda.auto_create_topics_enabled=true
    volumes:
      - posthog-local-redpanda-data:/var/lib/redpanda/data
    environment:
      ALLOW_PLAINTEXT_LISTENER: 'true'
    healthcheck:
      test: curl -f http://localhost:9644/v1/status/ready || exit 1
      interval: 3s
      timeout: 10s
      retries: 10
    depends_on:
      - zookeeper
    ports:
      - '6092:9092'

  clickhouse:
    image: ${CLICKHOUSE_SERVER_IMAGE:-clickhouse/clickhouse-server:25.12.5.44}
    restart: on-failure
    environment:
      CLICKHOUSE_SKIP_USER_SETUP: 1
      KAFKA_HOSTS: 'kafka:9092'
      AWS_ACCESS_KEY_ID: object_storage_root_user
      AWS_SECRET_ACCESS_KEY: object_storage_root_password
    healthcheck:
      test: ['CMD-SHELL', 'wget --no-verbose --tries=1 --spider http://localhost:8123/ping || exit 1']
      interval: 3s
      timeout: 10s
      retries: 10
    volumes:
      - ./posthog/idl:/idl
      - ./docker/clickhouse/docker-entrypoint-initdb.d:/docker-entrypoint-initdb.d
      - ./docker/clickhouse/config.xml:/etc/clickhouse-server/config.xml
      - ./docker/clickhouse/config.d/default.xml:/etc/clickhouse-server/config.d/default.xml
      - ./docker/clickhouse/users-dev.xml:/etc/clickhouse-server/users.xml
      - ./docker/clickhouse/user_defined_function.xml:/etc/clickhouse-server/user_defined_function.xml
      - ./posthog/user_scripts:/var/lib/clickhouse/user_scripts
    depends_on:
      - kafka
      - zookeeper
    ports:
      - '6123:8123'
      - '6900:9000'

  objectstorage:
    image: minio/minio:RELEASE.2025-04-22T22-12-26Z
    restart: on-failure
    environment:
      MINIO_ROOT_USER: object_storage_root_user
      MINIO_ROOT_PASSWORD: object_storage_root_password
    entrypoint: sh
    command: -c 'mkdir -p /data/posthog /data/ducklake-dev /data/ai-blobs && minio server --address ":19000" --console-address ":19001" /data'
    ports:
      - '6190:19000'
      - '6191:19001'

  worker:
    image: ghcr.io/posthog/posthog:latest
    command: ./bin/docker-worker-celery --with-scheduler
    restart: on-failure
    deploy:
      resources:
        limits:
          memory: 4G
    environment:
      CELERY_WORKER_CONCURRENCY: '2'
      SKIP_ASYNC_MIGRATIONS_SETUP: '1'
      SECRET_KEY: 'fc4807d4970911313b5e61e0a34dedb4470d73dccf8e984ad6de2c6c661bf4ef'
      PLUGIN_SERVER_IDLE: 1
      OTEL_SDK_DISABLED: 'true'
      DISABLE_SECURE_SSL_REDIRECT: 'true'
      IS_BEHIND_PROXY: 'true'
      DATABASE_URL: 'postgres://posthog:posthog@db:5432/posthog'
      CLICKHOUSE_HOST: 'clickhouse'
      CLICKHOUSE_DATABASE: 'posthog'
      CLICKHOUSE_SECURE: 'false'
      CLICKHOUSE_VERIFY: 'false'
      CLICKHOUSE_API_USER: 'api'
      CLICKHOUSE_API_PASSWORD: 'apipass'
      CLICKHOUSE_APP_USER: 'app'
      CLICKHOUSE_APP_PASSWORD: 'apppass'
      KAFKA_HOSTS: 'kafka'
      REDIS_URL: 'redis://redis7:6379/'
      PGHOST: db
      PGUSER: posthog
      PGPASSWORD: posthog
      DEPLOYMENT: hobby
      CDP_API_URL: 'http://plugins:6738'
      FLAGS_REDIS_ENABLED: 'false'
      OBJECT_STORAGE_ENDPOINT: http://objectstorage:19000
      OBJECT_STORAGE_ACCESS_KEY_ID: 'object_storage_root_user'
      OBJECT_STORAGE_SECRET_ACCESS_KEY: 'object_storage_root_password'
      OBJECT_STORAGE_ENABLED: 'true'
      OBJECT_STORAGE_BUCKET: 'posthog'
      SESSION_RECORDING_V2_S3_ENDPOINT: http://objectstorage:19000
      SESSION_RECORDING_V2_S3_ACCESS_KEY_ID: 'object_storage_root_user'
      SESSION_RECORDING_V2_S3_SECRET_ACCESS_KEY: 'object_storage_root_password'
      SESSION_RECORDING_V2_S3_BUCKET: 'posthog'
      RECORDING_API_URL: http://plugins:6738
      POSTHOG_SKIP_MIGRATION_CHECKS: 'true'
    depends_on:
      db:
        condition: service_healthy
      redis7:
        condition: service_healthy
      clickhouse:
        condition: service_healthy
      kafka:
        condition: service_healthy

  capture:
    image: ghcr.io/posthog/posthog/capture:master
    restart: on-failure
    environment:
      ADDRESS: '0.0.0.0:3000'
      KAFKA_TOPIC: 'events_plugin_ingestion'
      KAFKA_HOSTS: 'kafka:9092'
      REDIS_URL: 'redis://redis7:6379/'
      CAPTURE_MODE: events
      RUST_LOG: 'info,rdkafka=warn'
    depends_on:
      redis7:
        condition: service_healthy
      kafka:
        condition: service_healthy

  replay-capture:
    image: ghcr.io/posthog/posthog/capture:master
    restart: on-failure
    environment:
      ADDRESS: '0.0.0.0:3000'
      KAFKA_TOPIC: 'session_recording_snapshot_item_events'
      KAFKA_HOSTS: 'kafka:9092'
      REDIS_URL: 'redis://redis7:6379/'
      CAPTURE_MODE: recordings
      RUST_LOG: 'info,rdkafka=warn'
    depends_on:
      redis7:
        condition: service_healthy
      kafka:
        condition: service_healthy

  caddy:
    image: caddy:2
    restart: on-failure
    ports:
      - '80:80'
      - '443:443'
    volumes:
      - ./Caddyfile.local:/etc/caddy/Caddyfile
      - posthog-local-caddy-data:/data
      - posthog-local-caddy-config:/config
    depends_on:
      - web
      - capture
      - replay-capture

  web:
    image: ghcr.io/posthog/posthog:latest
    command: /bin/bash -c "./bin/migrate-check && ./bin/docker-server-unit"
    restart: on-failure
    volumes:
      - ./posthog:/code/posthog                                                                             
    environment:
      SECRET_KEY: 'fc4807d4970911313b5e61e0a34dedb4470d73dccf8e984ad6de2c6c661bf4ef'
      USE_GRANIAN: 'true'
      GRANIAN_WORKERS: '1'
      OTEL_SDK_DISABLED: 'true'
      DISABLE_SECURE_SSL_REDIRECT: 'true'
      IS_BEHIND_PROXY: 'true'
      SITE_URL: 'https://posthog.dev-gov.ironflow.ai'
      DATABASE_URL: 'postgres://posthog:posthog@db:5432/posthog'
      CLICKHOUSE_HOST: 'clickhouse'
      CLICKHOUSE_DATABASE: 'posthog'
      CLICKHOUSE_SECURE: 'false'
      CLICKHOUSE_VERIFY: 'false'
      CLICKHOUSE_API_USER: 'api'
      CLICKHOUSE_API_PASSWORD: 'apipass'
      CLICKHOUSE_APP_USER: 'app'
      CLICKHOUSE_APP_PASSWORD: 'apppass'
      KAFKA_HOSTS: 'kafka'
      REDIS_URL: 'redis://redis7:6379/'
      PGHOST: db
      PGUSER: posthog
      PGPASSWORD: posthog
      DEPLOYMENT: hobby
      CDP_API_URL: 'http://plugins:6738'
      FLAGS_REDIS_ENABLED: 'false'
      OBJECT_STORAGE_ENDPOINT: http://objectstorage:19000
      OBJECT_STORAGE_ACCESS_KEY_ID: 'object_storage_root_user'
      OBJECT_STORAGE_SECRET_ACCESS_KEY: 'object_storage_root_password'
      OBJECT_STORAGE_ENABLED: 'true'
      OBJECT_STORAGE_BUCKET: 'posthog'
      SESSION_RECORDING_V2_S3_ENDPOINT: http://objectstorage:19000
      SESSION_RECORDING_V2_S3_ACCESS_KEY_ID: 'object_storage_root_user'
      SESSION_RECORDING_V2_S3_SECRET_ACCESS_KEY: 'object_storage_root_password'
      SESSION_RECORDING_V2_S3_BUCKET: 'posthog'
      RECORDING_API_URL: http://plugins:6738
      POSTHOG_SKIP_MIGRATION_CHECKS: 'true'
      JS_URL: ''
    depends_on:
      db:
        condition: service_healthy
      redis7:
        condition: service_healthy
      clickhouse:
        condition: service_healthy
      kafka:
        condition: service_healthy

  plugins:
    image: ghcr.io/posthog/posthog-node:latest
    command: node nodejs/dist/index.js
    restart: always
    environment:
      SECRET_KEY: 'fc4807d4970911313b5e61e0a34dedb4470d73dccf8e984ad6de2c6c661bf4ef'
      DATABASE_URL: 'postgres://posthog:posthog@db:5432/posthog'
      PERSONS_DATABASE_URL: 'postgres://posthog:posthog@db:5432/posthog'
      BEHAVIORAL_COHORTS_DATABASE_URL: 'postgres://posthog:posthog@db:5432/posthog'
      KAFKA_HOSTS: 'kafka:9092'
      REDIS_URL: 'redis://redis7:6379/'
      CLICKHOUSE_HOST: 'clickhouse'
      CLICKHOUSE_DATABASE: 'posthog'
      CLICKHOUSE_SECURE: 'false'
      CLICKHOUSE_VERIFY: 'false'
      CDP_REDIS_HOST: redis7
      CDP_REDIS_PORT: 6379
      INGESTION_REDIS_HOST: redis7
      INGESTION_REDIS_PORT: 6379
      POSTHOG_REDIS_HOST: redis7
      POSTHOG_REDIS_PORT: 6379
      LOGS_REDIS_HOST: redis7
      LOGS_REDIS_PORT: 6379
      LOGS_REDIS_TLS: 'false'
      COOKIELESS_REDIS_HOST: redis7
      COOKIELESS_REDIS_PORT: 6379
      SESSION_RECORDING_API_REDIS_HOST: redis7
      SESSION_RECORDING_API_REDIS_PORT: 6379
      OTEL_SDK_DISABLED: 'true'
      ENCRYPTION_SALT_KEYS: '00beef0000beef0000beef0000beef00'
      OBJECT_STORAGE_ENDPOINT: http://objectstorage:19000
      OBJECT_STORAGE_ACCESS_KEY_ID: 'object_storage_root_user'
      OBJECT_STORAGE_SECRET_ACCESS_KEY: 'object_storage_root_password'
      OBJECT_STORAGE_ENABLED: 'true'
      OBJECT_STORAGE_BUCKET: 'posthog'
      SESSION_RECORDING_V2_S3_ENDPOINT: http://objectstorage:19000
      SESSION_RECORDING_V2_S3_ACCESS_KEY_ID: 'object_storage_root_user'
      SESSION_RECORDING_V2_S3_SECRET_ACCESS_KEY: 'object_storage_root_password'
      SESSION_RECORDING_V2_S3_BUCKET: 'posthog'
    depends_on:
      db:
        condition: service_healthy
      redis7:
        condition: service_healthy
      clickhouse:
        condition: service_healthy
      kafka:
        condition: service_healthy

  migrate:
    image: ghcr.io/posthog/posthog:latest
    command: sh -c "python manage.py migrate && python manage.py migrate_clickhouse"
    restart: 'no'
    environment:
      SECRET_KEY: 'fc4807d4970911313b5e61e0a34dedb4470d73dccf8e984ad6de2c6c661bf4ef'
      DATABASE_URL: 'postgres://posthog:posthog@db:5432/posthog'
      CLICKHOUSE_HOST: 'clickhouse'
      CLICKHOUSE_DATABASE: 'posthog'
      CLICKHOUSE_SECURE: 'false'
      CLICKHOUSE_VERIFY: 'false'
      KAFKA_HOSTS: 'kafka'
      REDIS_URL: 'redis://redis7:6379/'
      PGHOST: db
      PGUSER: posthog
      PGPASSWORD: posthog
    depends_on:
      db:
        condition: service_healthy
      redis7:
        condition: service_healthy
      clickhouse:
        condition: service_healthy
      kafka:
        condition: service_healthy

volumes:
  posthog-local-pg-data:
  posthog-local-redpanda-data:
  posthog-local-caddy-data:
  posthog-local-caddy-config:

